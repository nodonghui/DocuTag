=\"logo-text\">DocuTag</span>\n        </div>\n\n        <h1 className=\"login-title\">시작하기</h1>\n        <p className=\"login-subtitle\">카카오 계정으로 간편하게 로그인하세요</p>\n\n        <button\n          className={`kakao-btn ${hovered ? \"kakao-btn-hover\" : \"\"}`}\n          onMouseEnter={() => setHovered(true)}\n          onMouseLeave={() => setHovered(false)}\n          onClick={handleKakaoLogin}\n        >\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" style={{ flexShrink: 0 }}>\n            <path\n              fillRule=\"evenodd\"\n              clipRule=\"evenodd\"\n              d=\"M10 3C6.134 3 3 5.462 3 8.5c0 1.928 1.13 3.627 2.85 4.686l-.726 2.657a.25.25 0 0 0 .374.277L8.74 14.1c.406.058.822.088 1.26.088 3.866 0 7-2.462 7-5.5S13.866 3 10 3z\"\n              fill=\"#191919\"\n            />\n          </svg>\n          카카오로 로그인\n        </button>\n\n        <p className=\"login-terms\">\n          로그인 시{\" \"}\n          <span className=\"login-link\">서비스 이용약관</span> 및{\" \"}\n          <span className=\"login-link\">개인정보 처리방침</span>에 동의하게 됩니다.\n        </p>\n      </div>\n    </div>\n  );\n}"],"mappings":"AAAA,OAASA,QAAQ,KAAQ,OAAO,CAChC,MAAO,oBAAoB,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAC5B,KAAM,CAAAC,sBAAsB,CAAC,uBAAuB,CACpD,KAAM,CAAAC,iBAAiB,CAAGD,sBAAsB,CAAC,mBAAmB,CAEpE,cAAe,SAAS,CAAAE,SAASA,CAAA,CAAG,CAClC,KAAM,CAACC,OAAO,CAAEC,UAAU,CAAC,CAAGT,QAAQ,CAAC,KAAK,CAAC,CAE7C,KAAM,CAAAU,gBAAgB,CAAGA,CAAA,GAAM,CAC7BC,MAAM,CAACC,QAAQ,CAACC,IAAI,CAAGP,iBAAiB,CAC1C,CAAC,CAED,mBACEF,KAAA,QAAKU,SAAS,CAAC,iBAAiB,CAAAC,QAAA,eAC9Bb,IAAA,QAAKY,SAAS,CAAC,uBAAuB,CAAE,CAAC,cACzCZ,IAAA,QAAKY,SAAS,CAAC,uBAAuB,CAAE,CAAC,cAEzCV,KAAA,QAAKU,SAAS,CAAC,YAAY,CAAAC,QAAA,eACzBX,KAAA,QAAKU,SAAS,CAAC,WAAW,CAAAC,QAAA,eACxBb,IAAA,QAAKY,SAAS,CAAC,WAAW,CAAAC,QAAA,cACxBX,KAAA,QAAKY,KAAK,CAAC,IAAI,CAACC,MAAM,CAAC,IAAI,CAACC,OAAO,CAAC,WAAW,CAACC,IAAI,CAAC,MAAM,CAAAJ,QAAA,eACzDb,IAAA,SAAMc,KAAK,CAAC,IAAI,CAACC,MAAM,CAAC,IAAI,CAACG,EAAE,CAAC,GAAG,CAACD,IA