{
  "hooks": {
    "PreToolUse": [
    {
      "matcher": "Edit|Write|Create",
      "hooks": [
        {
          "type": "command",
          "command": "python3 .claude/hooks/check_approved.py"
        },
        {
          "type": "command",
          "command": "python3 .claude/hooks/pre_tool_logger.py"
        }
      ]
    }
  ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/post_tool_logger.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/prompt_logger.py"
          }
        ]
      }
    ]
  }
}